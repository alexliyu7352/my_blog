---
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import { useTranslations } from "@/i18n";
import config from "@/config";

type SearchLang = "en" | "zh" | "zh-tw";

type Props = {
  searchLang: SearchLang;
};

const { searchLang } = Astro.props;

// Pagefind's CJK word segmentation misses compound words (searching 复盘
// did not find the post titled …复盘…; Pagefind issue #987), so search is a
// small custom substring search over a per-language static index instead.
// Each language gets its own search page, so visitors search the language
// they are currently browsing.
const htmlLang =
  searchLang === "zh" ? "zh-CN" : searchLang === "zh-tw" ? "zh-TW" : "en";
// zh-tw is not an Astro i18n locale; utility URLs there fall back to "en",
// same as the rest of the zh-tw pages.
const locale = searchLang === "zh" ? "zh" : "en";

// Redirect to 404 page if `search` feature is not enabled
const notFoundUrl = getRelativeLocaleUrl(locale, "404");
if (config.features.search === false && notFoundUrl) {
  return Astro.rewrite(notFoundUrl);
}

const backUrl = config.features.showBackButton
  ? `${Astro.url.pathname}`
  : getRelativeLocaleUrl(locale, "");

const t = useTranslations(locale);

const strings = {
  en: {
    docTitle: `${t.pages.searchTitle} | ${config.site.title}`,
    pageTitle: t.pages.searchTitle,
    pageDesc: t.pages.searchDesc,
    placeholder: t.a11y.searchPlaceholder,
    results: (n: number, q: string) => `${n} result${n === 1 ? "" : "s"} for ${q}`,
    noResults: (q: string) => `No results for ${q}`,
    failed: "Search index failed to load. Please try again later.",
  },
  zh: {
    docTitle: "搜索 | AI擺渡人 Alex",
    pageTitle: "搜索",
    pageDesc: "搜索站内全部简体中文文章。",
    placeholder: "搜索文章……",
    results: (n: number, q: string) => `为 ${q} 找到 ${n} 篇文章`,
    noResults: (q: string) => `没有找到与 ${q} 相关的文章`,
    failed: "搜索索引加载失败，请稍后再试。",
  },
  "zh-tw": {
    docTitle: "搜尋 | AI擺渡人 Alex",
    pageTitle: "搜尋",
    pageDesc: "搜尋站內全部繁體中文文章。",
    placeholder: "搜尋文章……",
    results: (n: number, q: string) => `為 ${q} 找到 ${n} 篇文章`,
    noResults: (q: string) => `沒有找到與 ${q} 相關的文章`,
    failed: "搜尋索引載入失敗，請稍後再試。",
  },
}[searchLang];

const indexUrl = `/search-index/${searchLang}.json`;
---

<Layout htmlLang={htmlLang} title={strings.docTitle}>
  <Header />

  <Breadcrumb />

  <Main pageTitle={strings.pageTitle} pageDesc={strings.pageDesc}>
    <div
      id="site-search"
      transition:persist
      data-backurl={backUrl}
      data-index-url={indexUrl}
      data-strings={JSON.stringify({
        results: strings.results(0, "§q§"),
        noResults: strings.noResults("§q§"),
        failed: strings.failed,
      })}
    >
      <form id="site-search-form" role="search">
        <input
          id="site-search-input"
          type="search"
          placeholder={strings.placeholder}
          aria-label={strings.pageTitle}
          autocomplete="off"
        />
        <button
          id="site-search-clear"
          type="button"
          aria-label="Clear"
          hidden>✕</button
        >
      </form>
      <p id="site-search-message" class="site-search-message"></p>
      <div id="site-search-results"></div>
    </div>
  </Main>

  <Footer />
</Layout>

<script>
  type SearchItem = {
    title: string;
    desc: string;
    tags: string[];
    url: string;
    date: string;
    headings: string[];
    text: string;
  };

  let indexPromise: Promise<SearchItem[]> | null = null;
  let indexCache: SearchItem[] | null = null;

  function escapeHtml(s: string): string {
    return s
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;");
  }

  function highlight(escaped: string, terms: string[]): string {
    let out = escaped;
    for (const term of terms) {
      if (!term) continue;
      const needle = escapeHtml(term).replace(
        /[.*+?^${}()|[\]\\]/g,
        "\\$&"
      );
      out = out.replace(new RegExp(needle, "gi"), m => `<mark>${m}</mark>`);
    }
    return out;
  }

  function countOccurrences(haystack: string, needle: string): number {
    if (!needle) return 0;
    let count = 0;
    let i = haystack.indexOf(needle);
    while (i !== -1) {
      count++;
      i = haystack.indexOf(needle, i + needle.length);
    }
    return count;
  }

  function searchPosts(items: SearchItem[], rawQuery: string) {
    const query = rawQuery.trim().toLowerCase();
    if (!query) return [];
    const terms = query.split(/\s+/).filter(Boolean);

    const scored: { item: SearchItem; score: number }[] = [];
    for (const item of items) {
      const title = item.title.toLowerCase();
      const desc = item.desc.toLowerCase();
      const tags = item.tags.join(" ").toLowerCase();
      const headings = item.headings.join(" ").toLowerCase();
      const text = item.text.toLowerCase();

      let score = 0;
      let matchedAll = true;
      for (const term of terms) {
        let termScore = 0;
        if (title.includes(term)) termScore += 100;
        if (headings.includes(term)) termScore += 40;
        if (tags.includes(term)) termScore += 30;
        if (desc.includes(term)) termScore += 20;
        termScore += Math.min(countOccurrences(text, term), 20) * 2;
        if (termScore === 0) {
          matchedAll = false;
          break;
        }
        score += termScore;
      }
      if (matchedAll) scored.push({ item, score });
    }
    return scored.sort((a, b) => b.score - a.score).slice(0, 20);
  }

  function makeExcerpt(item: SearchItem, terms: string[]): string {
    const text = item.text;
    const lower = text.toLowerCase();
    let pos = -1;
    for (const term of terms) {
      const i = lower.indexOf(term);
      if (i !== -1 && (pos === -1 || i < pos)) pos = i;
    }
    if (pos === -1) {
      const d = item.desc;
      return d.length > 160 ? d.slice(0, 160) + "…" : d;
    }
    const start = Math.max(0, pos - 60);
    const end = Math.min(text.length, pos + 100);
    return (
      (start > 0 ? "…" : "") +
      text.slice(start, end) +
      (end < text.length ? "…" : "")
    );
  }

  function initSearch() {
    const root = document.querySelector<HTMLElement>("#site-search");
    if (!root || root.dataset.initialized) return;
    root.dataset.initialized = "true";

    const input = root.querySelector<HTMLInputElement>("#site-search-input");
    const clearBtn = root.querySelector<HTMLButtonElement>(
      "#site-search-clear"
    );
    const message = root.querySelector<HTMLElement>("#site-search-message");
    const resultsEl = root.querySelector<HTMLElement>("#site-search-results");
    const form = root.querySelector<HTMLFormElement>("#site-search-form");
    if (!input || !message || !resultsEl || !form) return;

    const strings = JSON.parse(root.dataset.strings ?? "{}") as {
      results: string;
      noResults: string;
      failed: string;
    };
    const formatMsg = (tpl: string, n: number, q: string) =>
      tpl.replace("0", String(n)).split("§q§").join(`"${q}"`);

    const loadIndex = (): Promise<SearchItem[]> => {
      if (indexCache) return Promise.resolve(indexCache);
      if (!indexPromise) {
        indexPromise = fetch(root.dataset.indexUrl ?? "")
          .then(r => {
            if (!r.ok) throw new Error(`HTTP ${r.status}`);
            return r.json() as Promise<SearchItem[]>;
          })
          .then(items => {
            indexCache = items;
            return items;
          });
      }
      return indexPromise;
    };

    const params = new URLSearchParams(window.location.search);
    let debounce: ReturnType<typeof setTimeout> | undefined;

    async function runSearch() {
      const q = input!.value.trim();
      if (clearBtn) clearBtn.hidden = q === "";

      const url = new URL(window.location.href);
      if (q) {
        url.searchParams.set("q", q);
      } else {
        url.searchParams.delete("q");
      }
      history.replaceState(history.state, "", url.toString());
      if (q) {
        sessionStorage.setItem(
          "backUrl",
          `${root!.dataset.backurl ?? window.location.pathname}?q=${encodeURIComponent(q)}`
        );
      }

      if (!q) {
        message!.textContent = "";
        resultsEl!.innerHTML = "";
        return;
      }

      let items: SearchItem[];
      try {
        items = await loadIndex();
      } catch {
        message!.textContent = strings.failed;
        resultsEl!.innerHTML = "";
        return;
      }
      if (input!.value.trim() !== q) return; // superseded by a newer query

      const terms = q.toLowerCase().split(/\s+/).filter(Boolean);
      const results = searchPosts(items, q);
      if (results.length === 0) {
        message!.textContent = formatMsg(strings.noResults, 0, q);
        resultsEl!.innerHTML = "";
        return;
      }
      message!.textContent = formatMsg(strings.results, results.length, q);
      resultsEl!.innerHTML = results
        .map(({ item }) => {
          const excerpt = highlight(
            escapeHtml(makeExcerpt(item, terms)),
            terms
          );
          const title = highlight(escapeHtml(item.title), terms);
          return `
            <article class="site-search-result">
              <h3><a href="${item.url}">${title}</a></h3>
              <p class="site-search-meta">${item.date}</p>
              <p class="site-search-excerpt">${excerpt}</p>
            </article>`;
        })
        .join("");
    }

    form.addEventListener("submit", e => {
      e.preventDefault();
      void runSearch();
    });
    input.addEventListener("input", () => {
      clearTimeout(debounce);
      debounce = setTimeout(() => void runSearch(), 200);
    });
    input.addEventListener("focus", () => {
      // Warm the index cache so the first keystroke feels instant.
      void loadIndex().catch(() => undefined);
    });
    clearBtn?.addEventListener("click", () => {
      input.value = "";
      input.focus();
      void runSearch();
    });

    const initial = params.get("q");
    if (initial) {
      input.value = initial;
      void runSearch();
    }
  }

  document.addEventListener("astro:after-swap", initSearch);
  initSearch();
</script>

<style>
  #site-search {
    --search-border: var(--border);
  }

  #site-search-form {
    position: relative;
  }

  #site-search-input {
    width: 100%;
    padding: 0.625rem 2.5rem 0.625rem 0.75rem;
    font-weight: 400;
    color: var(--foreground);
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 0.375rem;
  }

  #site-search-input:focus-visible {
    outline: 1px solid var(--accent);
  }

  #site-search-clear {
    position: absolute;
    top: 50%;
    right: 0.5rem;
    transform: translateY(-50%);
    padding: 0.25rem 0.5rem;
    color: var(--foreground);
    opacity: 0.6;
    cursor: pointer;
  }

  #site-search-clear:hover {
    opacity: 1;
  }

  .site-search-message {
    margin-top: 1rem;
    opacity: 0.75;
  }

  .site-search-result {
    padding: 1rem 0;
    border-bottom: 1px solid var(--border);
  }

  .site-search-result h3 {
    font-size: 1.125rem;
    font-weight: 600;
  }

  .site-search-result h3 a {
    color: var(--accent);
    text-decoration-style: dashed;
    text-underline-offset: 4px;
  }

  .site-search-result h3 a:hover {
    text-decoration-line: underline;
  }

  .site-search-meta {
    font-size: 0.875rem;
    opacity: 0.7;
  }

  .site-search-excerpt {
    margin-top: 0.25rem;
  }

  .site-search-excerpt mark,
  .site-search-result h3 mark {
    background: transparent;
    color: inherit;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
