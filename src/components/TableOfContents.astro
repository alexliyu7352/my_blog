---
type Heading = { depth: number; slug: string; text: string };

type Props = {
  headings: Heading[];
  lang?: string;
};

const { headings, lang = "en" } = Astro.props;
const tocHeadings = headings.filter(h => h.depth === 2 || h.depth === 3);
const label =
  lang === "zh" ? "本页目录" : lang === "zh-tw" ? "本頁目錄" : "On this page";
---

{
  tocHeadings.length > 1 && (
    <nav id="toc" aria-label="Table of contents" class="toc">
      <p class="toc-label">{label}</p>
      <ul class="toc-list">
        {tocHeadings.map(h => (
          <li>
            <a
              href={`#${h.slug}`}
              data-toc-link={h.slug}
              class:list={["toc-link", { "toc-sub": h.depth === 3 }]}
            >
              {h.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

<style>
  .toc {
    font-size: 13px;
  }
  .toc-label {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.55;
    margin-bottom: 10px;
    padding-inline-start: 12px;
  }
  .toc-list {
    border-inline-start: 1px solid
      color-mix(in srgb, currentColor 14%, transparent);
    max-height: calc(100vh - 11rem);
    overflow-y: auto;
    scrollbar-width: thin;
    padding-bottom: 4px;
  }
  .toc-link {
    display: block;
    margin-inline-start: -1px;
    border-inline-start: 2px solid transparent;
    border-radius: 0 6px 6px 0;
    padding: 5px 12px;
    line-height: 1.45;
    opacity: 0.6;
    text-decoration: none;
    transition:
      opacity 0.15s ease,
      color 0.15s ease,
      background-color 0.15s ease,
      border-color 0.15s ease;
  }
  .toc-link:hover {
    opacity: 1;
    background: color-mix(in srgb, var(--accent) 7%, transparent);
  }
  .toc-sub {
    padding-inline-start: 24px;
    font-size: 12.5px;
  }
  .toc-link.toc-active {
    opacity: 1;
    color: var(--accent);
    border-inline-start-color: var(--accent);
    font-weight: 600;
    background: color-mix(in srgb, var(--accent) 8%, transparent);
  }
</style>

<script is:inline data-astro-rerun>
  (function () {
    function initTocSpy() {
      const links = Array.from(document.querySelectorAll("[data-toc-link]"));
      if (links.length === 0) return;
      const heads = links
        .map(l => document.getElementById(l.getAttribute("data-toc-link")))
        .filter(Boolean);
      if (heads.length === 0) return;
      const list = document.querySelector(".toc-list");
      let ticking = false;

      function update() {
        ticking = false;
        const pos = window.scrollY + 140;
        let current = heads[0];
        for (const h of heads) {
          const top = h.getBoundingClientRect().top + window.scrollY;
          if (top <= pos) current = h;
          else break;
        }
        for (const l of links) {
          l.classList.toggle(
            "toc-active",
            l.getAttribute("data-toc-link") === current.id
          );
        }
        const active = links.find(
          l => l.getAttribute("data-toc-link") === current.id
        );
        if (active && list && list.scrollHeight > list.clientHeight) {
          const lr = list.getBoundingClientRect();
          const ar = active.getBoundingClientRect();
          if (ar.top < lr.top || ar.bottom > lr.bottom) {
            active.scrollIntoView({ block: "nearest" });
          }
        }
      }
      function onScroll() {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      }
      if (window.__tocSpyCleanup) window.__tocSpyCleanup();
      window.addEventListener("scroll", onScroll, { passive: true });
      window.addEventListener("resize", onScroll);
      window.__tocSpyCleanup = function () {
        window.removeEventListener("scroll", onScroll);
        window.removeEventListener("resize", onScroll);
      };
      update();
    }
    initTocSpy();
  })();
</script>
